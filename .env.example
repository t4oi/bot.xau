# =============================================================================
# XAUUSD Pro Signal Bot — Environment Variables Template
# Copy this file to ".env" and fill in your real values.
# =============================================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=8952278702
TELEGRAM_ADMIN_IDS=8952278702

# --- Data Source (BiQuote) ---
DATA_SOURCE=biquote
BIQUOTE_BASE_URL=https://biquote.io/api
TRADING_SYMBOL=XAUUSD

# --- Trading Parameters ---
ACCOUNT_BALANCE_USD=1000
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSSES=3
MAX_DAILY_LOSS_PCT=5.0
MAX_DRAWDOWN_PCT=15.0
MIN_RISK_REWARD=1.2
DEFAULT_TAKE_PROFITS=3
ATR_PERIOD=14
ATR_SL_MULTIPLIER=1.3
ATR_TP_MULTIPLIER=3.0
ATR_TP_MULTIPLIERS=1.3,2.2,3.2

# --- Analysis ---
ACTIVE_TIMEFRAMES=1m,5m,15m,30m,1h,4h
PRIMARY_TIMEFRAME=15m
HIGHER_TIMEFRAME=4h
MIN_CONFLUENCE_SCORE=65
SIGNAL_COOLDOWN_MINUTES=30

# --- Database ---
DATABASE_URL=sqlite:///./data/xauusd_bot.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log

# --- Web Dashboard ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_USERNAME=admin
WEB_PASSWORD=changeme123

# --- Scheduler ---
SCAN_INTERVAL_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=300
MONITOR_INTERVAL_SECONDS=20
